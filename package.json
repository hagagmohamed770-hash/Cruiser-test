  "description": "تطبيق شامل لإدارة الاستثمارات العقارية والعقود والأقساط والشركاء والخزينة",
  "main": "index.html",
  "scripts": {
    "start": "npx serve .",
    "dev": "npx live-server --port=8000 --open=/",
